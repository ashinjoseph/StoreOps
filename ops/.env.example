# Local-only values for the Docker database in ops/db/compose.yml, which
# listens on this machine only. Never use them anywhere else.
# Copy to ops/.env (ignored by git).
OPS_DB_SUPERUSER_PASSWORD=local-only-super
OPS_OWNER_PASSWORD=local-only-owner
OPS_APP_PASSWORD=local-only-app
OPS_READ_PASSWORD=local-only-read
OPS_DB_OWNER_URL=postgres://ops_owner:local-only-owner@127.0.0.1:54329/ops
OPS_DB_APP_URL=postgres://ops_app:local-only-app@127.0.0.1:54329/ops
# Used by the tests (any Postgres 16/17 superuser connection works):
OPS_DB_SUPERUSER_URL=postgres://postgres:local-only-super@127.0.0.1:54329/ops
