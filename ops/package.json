{
  "name": "storeops-ops",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "pretypecheck": "npm run build:ui",
    "typecheck": "tsc --noEmit && tsc --noEmit -p parity",
    "pretest": "npm run build:ui",
    "test": "vitest run",
    "preparity": "npm run build:ui",
    "parity": "node parity/cli.mjs",
    "build:ui": "node tools/build-ui.mjs",
    "dev": "node --env-file-if-exists=.dev.vars node_modules/wrangler/bin/wrangler.js dev",
    "pin:set": "node --env-file-if-exists=.dev.vars --import ./tools/ts-resolve.mjs --experimental-strip-types tools/set-pin.ts",
    "till:check": "node --experimental-strip-types tools/till-check.ts",
    "export:sheet": "node --experimental-strip-types tools/export-sheet.ts",
    "import:sheet": "node --import ./tools/ts-resolve.mjs --experimental-strip-types tools/import.ts",
    "import:purchases": "node --import ./tools/ts-resolve.mjs --experimental-strip-types tools/import-purchases.ts",
    "reconcile:import": "node --import ./tools/ts-resolve.mjs --experimental-strip-types tools/reconcile-import.ts",
    "restore:nightly": "node --env-file-if-exists=.env --import ./tools/ts-resolve.mjs --experimental-strip-types tools/restore-nightly.ts",
    "db:up": "docker compose --env-file .env -f db/compose.yml up -d --wait",
    "db:down": "docker compose --env-file .env -f db/compose.yml down",
    "db:reset": "docker compose --env-file .env -f db/compose.yml down -v && npm run db:up && npm run db:migrate && npm run db:seed",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types tools/db-migrate.ts",
    "db:psql": "docker compose --env-file .env -f db/compose.yml exec db sh -c \"PGPASSWORD=\\\"\\$OPS_APP_PASSWORD\\\" psql -U ops_app -d ops\"",
    "db:seed": "echo \"no seed data yet (a later card adds it)\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "pg": "^8.23.1",
    "zod": "4.6.7"
  }
}
